# OpenRouter (server-side only; never expose to the browser)
OPENROUTER_API_KEY=

# Supabase (service_role; server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Models are pinned on purpose: an alias like "-latest" would silently change results.
TARGET_MODEL=google/gemini-3.5-flash-lite
EVALUATOR_MODEL=anthropic/claude-haiku-5.5

# Anonymous quotas, counted per attack request
SESSION_HOUR_LIMIT=18
SESSION_DAY_LIMIT=60
GLOBAL_DAY_LIMIT=300

# Timeout for the quota RPC call, in seconds
QUOTA_TIMEOUT_SECONDS=5
